        bool exists = sqlite3_step(stmt) == SQLITE_ROW && sqlite3_column_int(stmt, 0) > 0;
        sqlite3_finalize(stmt);
        if (exists) return;

        string salt, hash;
        createPasswordHash(password, salt, hash);
        sqlite3_prepare_v2(db,
            "INSERT INTO users(username,password_hash,salt,role,patient_id) VALUES(?,?,?,?,?);",
            -1, &stmt, nullptr);
