}

void doctorMenu(Database& db) {
    int choice;
    do {
        cout << "\n===== DOCTOR MENU ====="
             << "\n1. View All Patients\n2. Search Patient by ID"
             << "\n3. Search Patient by Name\n4. Update Medical Details"
             << "\n5. View Appointments\n0. Logout\n";
        choice = readInt("Enter choice: ");
        if (choice == 1) db.displayPatients();
        else if (choice == 2) db.displayPatients(readInt("Patient ID: "));
        else if (choice == 3) db.searchPatientByName(readLine("Patient name: "));
        else if (choice == 4) {
            int id = readInt("Patient ID: ");
            string disease = readLine("Updated medical condition: ");
            db.updateDisease(id, disease);
        } else if (choice == 5) db.displayAppointments();
        else if (choice != 0) cout << "Invalid choice.\n";
    } while (choice != 0);
}

void patientMenu(Database& db, int patientId) {
    int choice;
    do {
        cout << "\n===== PATIENT MENU ====="
             << "\n1. View My Profile\n2. Book Appointment"
             << "\n3. View My Appointments\n0. Logout\n";
        choice = readInt("Enter choice: ");
        if (choice == 1) db.displayPatients(patientId);
        else if (choice == 2) {
            db.displayDoctors();
            int doctorId = readInt("Doctor ID: ");
            string date = readLine("Appointment date (e.g. 20-11-2026): ");
            string time = readLine("Appointment time (e.g. 10:30 AM): ");
            db.bookAppointment(patientId, doctorId, date, time);
        } else if (choice == 3) db.displayAppointments(patientId);
        else if (choice != 0) cout << "Invalid choice.\n";
    } while (choice != 0);
}

