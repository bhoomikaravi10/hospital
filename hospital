                if (name.empty() || age <= 0) throw invalid_argument("Invalid doctor details.");
                db.addDoctor(name, age, phone, spec);
            } else if (choice == 8) db.displayDoctors();
            else if (choice == 9) {
                int id = readInt("Doctor ID: ");
                string name = readLine("New name: ");
                int age = readInt("New age: ");
                string phone = readLine("New phone: ");
                string spec = readLine("New specialization: ");
                if (age <= 0) throw invalid_argument("Age must be positive.");
                db.updateDoctor(id, name, age, phone, spec);
            } else if (choice == 10) db.deleteDoctor(readInt("Doctor ID to delete: "));
            else if (choice == 11) db.displayAppointments();
